# App
APP_NAME="ITDesk — AI Ticket Management System"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="change-me-in-production-please-use-a-long-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend origin (CORS / refresh cookie domain)
FRONTEND_ORIGIN="http://localhost:5173"

# Database
# SQLite (default / local development)
DATABASE_URL="sqlite:///./data/itdesk.db"
# PostgreSQL (production) — uncomment and set:
# DATABASE_URL="postgresql+psycopg://user:pass@localhost:5432/itdesk"

# Seed credentials (used by seed.py)
SEED_ADMIN_EMAIL="admin@itdesk.io"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_USER_EMAIL="user@itdesk.io"
SEED_USER_PASSWORD="User@12345"

# Admin registration code (required when registering with role=admin)
ADMIN_REGISTRATION_CODE=

# --- NVIDIA AI (backend-only secret — never expose to frontend) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# SMTP (optional — reset emails logged to console when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="no-reply@itdesk.io"
